# Copy to .env and fill in only the provider you use.
# Credentials are read from the environment. Never commit .env.

LLM_PROVIDER=vertex_ai
MODEL_NAME=gemini-2.0-flash-001

# Vertex AI — uses Application Default Credentials (gcloud auth application-default login).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash-001

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional path overrides
# JOBS_DB=data/jobs.db
# MASTER_RESUME=resume/master_resume.docx
# BASE_RESUME=resume/base_resume.pdf

# Overleaf Git token from Account Settings. Used only to pull the master project.
# The agent never pushes tailored resumes back to that project.
OVERLEAF_GIT_TOKEN=

# Used only when a company career site asks you to create an account. Not written into the database.
COMPANY_SITE_PASSWORD=

# Naukri sign-in. Leave blank to keep using a session you created in the browser.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
